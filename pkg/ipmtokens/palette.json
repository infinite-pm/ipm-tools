{
  "_comment": "Source of truth for the ipmt token palette (colors + class-suffix mapping). Hand-edit this file; pkg/ipmtokens embeds it and pkg/mdhtml composes CSS from it at runtime, and ../vscode-ipm/scripts/gen-palette.ts generates the editor package.json rules, preview CSS, and src/palette.gen.ts from it. Token-type indices and modifier bits are defined in pkg/ipmtokens/tokens.go (SemanticTokenTypes / SemanticTokenModifiers). fg is the value for dark themes (editor background #1f1f1f, also fine on #121314 and black); fgLight is the value for light themes (background #ffffff). Every value has a text contrast of at least 4.5:1 (WCAG AA) on its background; the extension's tests compute it.",
  "rules": [
    { "type": "ipmEvent",      "class": "e-title",          "fg": "#ff8000", "fgLight": "#a65300" },
    { "type": "ipmEvent",      "mod": "alias",    "class": "e-alias",          "fg": "#ff8000", "fgLight": "#a65300" },
    { "type": "ipmEvent",      "mod": "hasAlias", "class": "e-title-aliased",  "fg": "#ffaa55", "fgLight": "#b35900" },
    { "type": "ipmEvent",      "mod": "marker",   "class": "e-marker",         "fg": "#ff8000", "fgLight": "#a65300", "bold": true },
    { "type": "ipmThing",      "class": "t-title",          "fg": "#6fc24f", "fgLight": "#2d6e1f" },
    { "type": "ipmThing",      "mod": "alias",    "class": "t-alias",          "fg": "#6fc24f", "fgLight": "#2d6e1f" },
    { "type": "ipmThing",      "mod": "hasAlias", "class": "t-title-aliased",  "fg": "#82b366", "fgLight": "#3c7a2a" },
    { "type": "ipmThing",      "mod": "marker",   "class": "t-marker",         "fg": "#6fc24f", "fgLight": "#2d6e1f", "bold": true },
    { "type": "ipmConcept",    "class": "c-title",          "fg": "#6c8ebf", "fgLight": "#1a5f9e" },
    { "type": "ipmConcept",    "mod": "alias",    "class": "c-alias",          "fg": "#6c8ebf", "fgLight": "#1a5f9e" },
    { "type": "ipmConcept",    "mod": "hasAlias", "class": "c-title-aliased",  "fg": "#9bb4d6", "fgLight": "#2877bd" },
    { "type": "ipmConcept",    "mod": "marker",   "class": "c-marker",         "fg": "#6c8ebf", "fgLight": "#1a5f9e", "bold": true },
    { "type": "ipmArrow",      "class": "arrow",            "fg": "#d4d4d4", "fgLight": "#404040", "bold": true },
    { "type": "ipmArrow",      "mod": "leadsTo",   "class": "L",              "fg": "#ff8000", "fgLight": "#a65300", "bold": true },
    { "type": "ipmArrow",      "mod": "partOf",    "class": "P",              "fg": "#6fc24f", "fgLight": "#2d6e1f", "bold": true },
    { "type": "ipmArrow",      "mod": "expresses", "class": "X",              "fg": "#6c8ebf", "fgLight": "#1a5f9e", "bold": true },
    { "type": "ipmArrow",      "mod": "nearTo",    "class": "N",              "fg": "#aaaaaa", "fgLight": "#6b6b6b", "bold": true },
    { "type": "ipmTypeMarker", "class": "type-marker",      "fg": "#b08fff", "fgLight": "#7e57c2" },
    { "type": "ipmRelation",   "class": "relation",         "fg": "#b08fff", "fgLight": "#7e57c2" },
    { "type": "ipmComment",    "class": "comment",          "fg": "#8c8c8c", "fgLight": "#6b6b6b", "italic": true },
    { "type": "ipmString",     "class": "string",           "fg": "#ce9178", "fgLight": "#a31515" },
    { "type": "ipmTooltip",    "class": "tooltip",          "fg": "#b58900", "fgLight": "#8a6d00", "italic": true },
    { "type": "ipmUnresolved", "class": "unresolved",       "fg": "#8a8a8a", "fgLight": "#767676" }
  ]
