{
  "_comment": "Source of truth for the ipmt token palette (colors + class-suffix mapping). Hand-edit this file; pkg/ipmtokens embeds it and pkg/mdhtml composes CSS from it at runtime, and ../vscode-ipm/scripts/gen-palette.ts generates the editor package.json rules, preview CSS, and src/palette.gen.ts from it. Token-type indices and modifier bits are defined in pkg/ipmtokens/tokens.go (SemanticTokenTypes / SemanticTokenModifiers). fg is the value for dark editor themes (background #1f1f1f, also fine on #121314 and black) and keeps a text contrast of at least 4.5:1 there. fgLight is the one value for every white background: a light editor theme, the pages md-html writes, and the figures drawn from this palette. It holds the colours of the figures and of the diagrams, so the source in a light editor looks like the diagram beside it; those colours are a look, not a contrast rule, and a test pins them so a change is made on purpose. cmd-dev/palette-page draws every value for review.",
  "rules": [
    { "type": "ipmEvent",      "class": "e-title",          "fg": "#ff8000", "fgLight": "#ff8000" },
    { "type": "ipmEvent",      "mod": "alias",    "class": "e-alias",          "fg": "#ffaa55", "fgLight": "#ffaa55" },
    { "type": "ipmEvent",      "mod": "hasAlias", "class": "e-title-aliased",  "fg": "#ff8000", "fgLight": "#ff8000" },
    { "type": "ipmEvent",      "mod": "marker",   "class": "e-marker",         "fg": "#ff8000", "fgLight": "#ff8000", "bold": true },
    { "type": "ipmThing",      "class": "t-title",          "fg": "#6fc24f", "fgLight": "#4d8a3a" },
    { "type": "ipmThing",      "mod": "alias",    "class": "t-alias",          "fg": "#82b366", "fgLight": "#82b366" },
    { "type": "ipmThing",      "mod": "hasAlias", "class": "t-title-aliased",  "fg": "#6fc24f", "fgLight": "#4d8a3a" },
    { "type": "ipmThing",      "mod": "marker",   "class": "t-marker",         "fg": "#6fc24f", "fgLight": "#4d8a3a", "bold": true },
    { "type": "ipmConcept",    "class": "c-title",          "fg": "#6c8ebf", "fgLight": "#6c8ebf" },
    { "type": "ipmConcept",    "mod": "alias",    "class": "c-alias",          "fg": "#9bb4d6", "fgLight": "#9bb4d6" },
    { "type": "ipmConcept",    "mod": "hasAlias", "class": "c-title-aliased",  "fg": "#6c8ebf", "fgLight": "#6c8ebf" },
    { "type": "ipmConcept",    "mod": "marker",   "class": "c-marker",         "fg": "#6c8ebf", "fgLight": "#6c8ebf", "bold": true },
    { "type": "ipmArrow",      "class": "arrow",            "fg": "#d4d4d4", "fgLight": "#404040", "bold": true },
    { "type": "ipmArrow",      "mod": "leadsTo",   "class": "L",              "fg": "#ff8000", "fgLight": "#ff8000", "bold": true },
    { "type": "ipmArrow",      "mod": "partOf",    "class": "P",              "fg": "#6fc24f", "fgLight": "#4d8a3a", "bold": true },
    { "type": "ipmArrow",      "mod": "expresses", "class": "X",              "fg": "#6c8ebf", "fgLight": "#6c8ebf", "bold": true },
    { "type": "ipmArrow",      "mod": "nearTo",    "class": "N",              "fg": "#aaaaaa", "fgLight": "#aaaaaa", "bold": true },
    { "type": "ipmTypeMarker", "class": "type-marker",      "fg": "#b08fff", "fgLight": "#b08fff" },
    { "type": "ipmRelation",   "class": "relation",         "fg": "#b08fff", "fgLight": "#b08fff" },
    { "type": "ipmComment",    "class": "comment",          "fg": "#8c8c8c", "fgLight": "#808080", "italic": true },
    { "type": "ipmString",     "class": "string",           "fg": "#ce9178", "fgLight": "#ce9178" },
    { "type": "ipmTooltip",    "class": "tooltip",          "fg": "#b58900", "fgLight": "#b58900", "italic": true },
    { "type": "ipmUnresolved", "class": "unresolved",       "fg": "#8a8a8a", "fgLight": "#8a8a8a" }
  ]
}
